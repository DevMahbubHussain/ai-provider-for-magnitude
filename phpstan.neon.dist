parameters:
	level: 8
	phpVersion:
		min: 70400
		max: 80400
	paths:
		- ai-provider-for-magnitude.php
		- includes/
	scanDirectories:
		# The AI Client ships in WordPress core 7.0+ and is not part of the WordPress stubs.
		# This path assumes the plugin sits in wp-content/plugins, as in a normal install.
		- ../../../wp-includes/php-ai-client
	treatPhpDocTypesAsCertain: false
